{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/salamou1944/AI_operating_memory/blob/main/PROTOCOLS/agent-message.schema.json",
  "title": "Agent Exchange Protocol Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "thread_id",
    "created_at",
    "sender",
    "recipient",
    "message_type",
    "subject",
    "body"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "0.1"
    },
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "thread_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "$ref": "#/$defs/party"
    },
    "recipient": {
      "oneOf": [
        {
          "$ref": "#/$defs/party"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      ]
    },
    "message_type": {
      "type": "string",
      "enum": [
        "proposal",
        "challenge",
        "evidence",
        "question",
        "revision",
        "decision",
        "handoff",
        "result",
        "blocker"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "claims": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "objections": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 3000
      }
    },
    "requested_action": {
      "$ref": "#/$defs/requestedAction"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "acknowledged",
        "accepted",
        "rejected",
        "blocked",
        "verified",
        "unverified"
      ]
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "transport_identity": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "type",
        "text"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "observation",
            "inference",
            "assumption",
            "hypothesis",
            "recommendation"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "reference",
        "supports"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "pull_request",
            "issue",
            "workflow_run",
            "test_result",
            "file",
            "url",
            "tool_result",
            "other"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requestedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "review",
            "answer",
            "execute",
            "verify",
            "handoff"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "permission_scope": {
          "type": "string",
          "enum": [
            "none",
            "read_only",
            "repository_write",
            "deployment",
            "external_write",
            "financial",
            "unknown"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_requested",
            "requested",
            "approved",
            "denied",
            "not_applicable"
          ]
        },
        "approver": {
          "type": "string",
          "maxLength": 128
        },
        "approval_reference": {
          "type": "string",
          "maxLength": 2000
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
